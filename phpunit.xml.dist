<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Veyra unit and bounded domain tests">
            <directory suffix="Test.php">tests/Unit</directory>
            <directory suffix="Test.php">tests/Checkout</directory>
            <directory suffix="Test.php">tests/Media</directory>
            <directory suffix="Test.php">tests/PaymentReview</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
