{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyra.invalid/contracts/schemas/context-graph.schema.json",
  "title": "Bounded Context Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "resource_version", "conversation_id", "actor_scope", "claims", "relationships", "focus_id", "foreground_journey_id", "paused_journey_ids", "pending_question_id", "refusal_states", "last_verified_operation", "assembled_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "graph_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "resource_version": { "type": "integer", "minimum": 1 },
    "conversation_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "actor_scope": { "$ref": "common.schema.json#/$defs/actorScope" },
    "claims": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "entity_id", "field", "typed_value", "authority_rank", "effective_from", "effective_until", "permission_policy_ref", "retention_policy_ref"],
        "properties": {
          "claim_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
          "entity_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
          "field": { "type": "string", "minLength": 1, "maxLength": 160 },
          "typed_value": { "$ref": "common.schema.json#/$defs/typedValue" },
          "authority_rank": { "type": "integer", "minimum": 1, "maximum": 7 },
          "effective_from": { "$ref": "common.schema.json#/$defs/utcInstant" },
          "effective_until": { "oneOf": [{ "$ref": "common.schema.json#/$defs/utcInstant" }, { "type": "null" }] },
          "permission_policy_ref": { "type": "string", "minLength": 1, "maxLength": 160 },
          "retention_policy_ref": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_claim_id", "relation", "to_claim_id"],
        "properties": {
          "from_claim_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
          "relation": { "enum": ["supersedes", "contradicts", "depends_on", "supports", "refers_to"] },
          "to_claim_id": { "$ref": "common.schema.json#/$defs/opaqueId" }
        }
      }
    },
    "focus_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/opaqueId" }, { "type": "null" }] },
    "foreground_journey_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/journeyId" }, { "type": "null" }] },
    "paused_journey_ids": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/journeyId" } },
    "pending_question_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/opaqueId" }, { "type": "null" }] },
    "refusal_states": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "source_message_id", "active"],
        "properties": {
          "scope": { "type": "string", "maxLength": 160 },
          "source_message_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
          "active": { "type": "boolean" }
        }
      }
    },
    "last_verified_operation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "result_code", "verified_at", "resource_refs"],
          "properties": {
            "operation_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
            "result_code": { "type": "string", "maxLength": 120 },
            "verified_at": { "$ref": "common.schema.json#/$defs/utcInstant" },
            "resource_refs": { "type": "array", "maxItems": 30, "items": { "$ref": "common.schema.json#/$defs/resourceRef" } }
          }
        }
      ]
    },
    "assembled_at": { "$ref": "common.schema.json#/$defs/utcInstant" }
  },
  "x-invariants": [
    "Factual authority and shopper-preference precedence are evaluated separately.",
    "Lower-authority claims never silently overwrite higher-authority claims.",
    "The graph is bounded, actor scoped, and excludes unrelated customer data."
  ]
}
