{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyra.invalid/contracts/schemas/confirmation.schema.json",
  "title": "Single-use sensitive-action confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "confirmation_id", "resource_version", "token_digest", "actor_scope", "conversation_id", "journey_id", "action", "tool_version", "resources", "canonical_material_payload", "state_hash", "state_hash_algorithm_version", "visible_summary_message_id", "visible_summary_rendering_version", "acknowledgements", "idempotency_scope", "correlation_id", "created_at", "expires_at", "status", "invalidation_reason"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "confirmation_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "resource_version": { "type": "integer", "minimum": 1 },
    "token_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actor_scope": { "$ref": "common.schema.json#/$defs/actorScope" },
    "conversation_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "journey_id": { "$ref": "common.schema.json#/$defs/journeyId" },
    "action": { "type": "string", "pattern": "^[a-z_]+\\.[a-z_]+$" },
    "tool_version": { "const": "1.0.0" },
    "resources": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "common.schema.json#/$defs/resourceRef" } },
    "canonical_material_payload": { "type": "object", "minProperties": 1 },
    "state_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state_hash_algorithm_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "visible_summary_message_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "visible_summary_rendering_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "acknowledgements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 160 } },
    "idempotency_scope": { "type": "string", "minLength": 1, "maxLength": 500 },
    "correlation_id": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "created_at": { "$ref": "common.schema.json#/$defs/utcInstant" },
    "expires_at": { "$ref": "common.schema.json#/$defs/utcInstant" },
    "status": { "enum": ["active", "consumed", "invalidated", "expired"] },
    "invalidation_reason": { "type": ["string", "null"], "maxLength": 240 }
  },
  "x-invariants": ["Plaintext reusable tokens are prohibited.", "Consumption requires immediate reauthorization/revalidation and atomic idempotency claim."]
}
